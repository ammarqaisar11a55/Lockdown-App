    <string name="settings_about">About Lockdown App</string>
    <string name="settings_about_body">Lockdown App works entirely offline. Schedules, history and enforcement never depend on an account, the internet or a server.</string>
    <string name="settings_limitations">What Android does not allow</string>
    <string name="settings_limitations_body">• Emergency calls, the power menu and the secure lock screen always stay available.\n• Recovery mode, safe mode on some devices, bootloader access and factory reset are outside any app\'s control. A factory reset removes Lockdown App entirely.\n• Without Device Owner, sessions use screen pinning, which the user can exit.\n• Some manufacturers restrict background work; exact timing may require allowing exact alarms and disabling battery optimization.\n• A developer with ADB access to a debug build can always recover the device.</string>
    <string name="settings_remove_owner">Remove device management</string>
    <string name="settings_remove_owner_body">Gives up Device Owner. Strong lockdown stops working until the device is provisioned again, which normally requires a factory reset.</string>
    <string name="settings_remove_owner_action">Remove Device Owner</string>
    <string name="settings_remove_owner_confirm">Lockdown App will no longer be able to enforce lockdown. Re-enabling it usually requires a factory reset. Continue?</string>
    <string name="settings_owner_removed">Device Owner removed.</string>
    <string name="settings_owner_not_removed">Device Owner could not be removed.</string>
